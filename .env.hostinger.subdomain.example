# Subdomain: https://repaircares.digitalcreatorss.com
# hPanel → Subdomains → document root MUST be: .../repaircares/public
# cd ~/domains/digitalcreatorss.com/public_html/repaircares

APP_NAME=RepairCares
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://repaircares.digitalcreatorss.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u922228303_repaircares
DB_USERNAME=u922228303_repaircares
DB_PASSWORD="your_mysql_password"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=log
