# Live: public_html/repaircares → forward requests to Laravel public/
<IfModule mod_rewrite.c>
    Options +FollowSymLinks
    RewriteEngine On
    RewriteBase /repaircares/

    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<Files .env>
    Require all denied
</Files>
